# ---- Build caches and generated output ----
# Gradle's caches churn on every build and are machine-specific. 22 of these
# were tracked, which is why `git status` was permanently dirty.
.gradle/
application_android/.cxx/
application_android/captures/
.kotlin/
*.hprof

# Rust build output (2.8 GB and growing).
mls-core/target/

# Machine-specific SDK paths - each developer's is different.
local.properties

# Packaged app binaries. The build produces these; they are not source.
*.apk
*.aab
*.apks
build-artifacts/

# Runtime process files.
*.pid

# NOTE on *.so above: it also excludes application_android/app/src/main/jniLibs,
# which holds libmls_core.so for each ABI. Those are REQUIRED to build a working
# APK and are deliberately not committed - build them from mls-core with
# ./mls-core/build-android.sh. Without that step the app loads no MLS core and
# MlsCore.isAvailable stays false.

# Gradle's agent and user-home caches. Named differently from .gradle/ above and
# so not covered by it: together they were 40,591 untracked files and 3.1 GB,
# which made `git status` unusable and `git add -A` genuinely dangerous.
.gradle-agent/
.gradle-user-home/

# Timestamped backup copies (e.g. messenger-backend.exe.bak-20260819-163850).
# The plain *.bak rule above does not match a suffix after .bak.
*.bak-*

# Generated by cbindgen from src/ffi.rs on every build (see build.rs). Nothing
# includes it - the Qt client mirrors the declarations as local typedefs and
# checks the ABI at runtime - and build.rs fails soft, so a committed copy could
# silently go stale and describe an ABI the library no longer has.
mls-core/include/mls_core.h

# Local DB query helper: hardcodes an absolute .env path and globs for psql.exe,
# so it only runs on one machine. No caller, no history, and it reads live
# database credentials. Keep it local rather than shipping it.
back-end/dbcheck.py
