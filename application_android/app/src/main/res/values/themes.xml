<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. Only used for the launch window before Compose
         takes over - actual app theming (colors, typography) lives in Theme.kt
         via Material3's MaterialTheme, not XML attributes. -->
    <style name="Theme.MessengerApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary_color</item>
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Deliberately no android:background. A theme-level background is
             inherited by every view that doesn't set its own, including the
             DialogLayout that Compose hosts dialogs in, where it painted an
             opaque white band around each dialog panel. windowBackground above
             is what actually styles the launch window. -->
    </style>

    <!-- Translucent theme for auth redirects -->
    <style name="Theme.MessengerApp.Translucent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>

</resources>