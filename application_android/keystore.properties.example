# Copy this file to keystore.properties (same directory) and fill in your
# own release keystore's credentials. keystore.properties is gitignored -
# never commit real signing credentials.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/release.keystore -alias messenger_release \
#     -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=messenger_release
storeFile=keystore/release.keystore
