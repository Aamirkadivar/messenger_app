<RCC>
    <qresource prefix="/">
        <file>../qml/main.qml</file>
        <file>../qml/TitleBar.qml</file>
        <file>../qml/Login.qml</file>
        <file>../qml/Register.qml</file>
        <file>../qml/ChatList.qml</file>
        <file>../qml/ChatView.qml</file>
        <file>../qml/ChatBackground.qml</file>
        <file>../qml/NewChatDialog.qml</file>
        <file>../qml/NewGroupDialog.qml</file>
        <file>../qml/GroupInfoPanel.qml</file>
        <file>../qml/MessageBubble.qml</file>
        <file>../qml/Settings.qml</file>
        <file>../qml/Avatar.qml</file>
        <file>../qml/GlassPanel.qml</file>
        <file>../qml/FrostedScrim.qml</file>
        <file>../qml/AmbientGlow.qml</file>
        <file>../qml/CallOverlay.qml</file>
        <file>../qml/RoundVideoOverlay.qml</file>
        <file>../qml/OverlayButton.qml</file>
        <file>../qml/RoundVideoBubble.qml</file>
        <file>../qml/CallActionButton.qml</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="send.svg">icons/send.svg</file>
        <file alias="app_icon.png">icons/app_icon.png</file>
        <!-- The .ico carries several sizes, so Windows picks the right one for
             the notification area rather than downscaling a 256px PNG. -->
        <file alias="app_icon.ico">icons/app_icon.ico</file>
    </qresource>
</RCC>
